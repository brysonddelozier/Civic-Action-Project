@page
@using CivicAction.Data
@model CivicAction.Pages.Students.IndexModel

@{
    ViewData["Title"] = "Index";
}


<h1 style = "margin-top: 30px; margin-bottom: 20px" >Students</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Students[0].FirstMidName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Students[0].LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Students[0].Grade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Students[0].School)
            </th>
            <th>
                Total Hours
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Students) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FirstMidName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Grade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.School)
            </td>
            <td>
                @item.Inclusions.Where(i => i.StudentId == item.Id).Sum(i => i.Hours)
            </td>
        </tr>
}
    </tbody>
</table>
