@page
@model CivicAction.Pages.Projects.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Project</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Project.Id" />
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Project.Title" class="control-label"></label>
                <input asp-for="Project.Title" class="form-control" aria-required="true"/>
                <span asp-validation-for="Project.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Project.Description" class="control-label"></label>
                <textarea asp-for="Project.Description" class="form-control" aria-required="true" rows="4"></textarea>
                <span asp-validation-for="Project.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Organization" class="control-label"></label>
                <input asp-for="Project.Organization" class="form-control" />
                <span asp-validation-for="Project.Organization" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.SiteLocation" class="control-label"></label>
                <input asp-for="Project.SiteLocation" class="form-control" />
                <span asp-validation-for="Project.SiteLocation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Start" class="control-label"></label>
                <input asp-for="Project.Start" class="form-control" />
                <span asp-validation-for="Project.Start" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.End" class="control-label"></label>
                <input asp-for="Project.End" class="form-control" />
                <span asp-validation-for="Project.End" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
