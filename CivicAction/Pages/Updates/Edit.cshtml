@page
@model CivicAction.Pages.Updates.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Update</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Update.Id" />
            <input type="hidden" asp-for="Update.ProjectId" />
            <input type="hidden" asp-for="Update.StudentId" />
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Update.Description" class="control-label"></label>
                <textarea asp-for="Update.Description" class="form-control" aria-required="true" rows="4"></textarea>
                <span asp-validation-for="Update.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Update.Date" class="control-label"></label>
                <input asp-for="Update.Date" class="form-control" aria-required="true"/>
                <span asp-validation-for="Update.Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Update.Hours" class="control-label"></label>
                <input asp-for="Update.Hours" class="form-control" />
                <span asp-validation-for="Update.Hours" class="text-danger"></span>
            </div>
            @if (Model.CurrentUser.IsAdmin)
            {
                <div class="form-group">
                    <button type="submit" name="Update.Status" value="Approved" class="btn btn-success">Approve</button>
                    <button type="submit" name="Update.Status" value="Rejected" class="btn btn-danger">Reject</button>
                </div>
            }
            else
            {
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            }

        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
