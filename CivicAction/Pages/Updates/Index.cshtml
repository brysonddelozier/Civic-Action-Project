@page
@model CivicAction.Pages.Updates.IndexModel

@{
    ViewData["Title"] = "Index";
}

@if (Model.CurrentUser?.IsAdmin == false && User.Identity?.IsAuthenticated == true)
{
    <h1 style = "margin-top: 30px; margin-bottom: 20px"> Got Progress to Share, @Model.CurrentUser?.FirstMidName? </h1>
}
else
{
    <h1 style = "margin-top: 30px; margin-bottom: 20px"> Manage Updates </h1>
}

@if (Model.CurrentUser?.IsAdmin == false)
{
    <p>
        <a class="btn-link" asp-page="Create">Add Update</a>
    </p style = "margin-bottom: 20px">
}

@if(Model.Update == null || !Model.Update.Any())
{
    <div class = "text-center mp-4">
        <img src = "~/images/update.jpg"
             alt = "No Update Illustration" 
             style = "max-width:450px; max-height:auto;"/>
        <p style= "color: rgb(87, 87, 87);"> No recent update </p>
    </div>
}
else
{
    <table class="table">
    <thead>
        <tr>
            <th>
                Update
            </th>
            <th>
                Student
            </th>
            <th>
                Project
            </th>
            <th>
                Student
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.Update[0].Date)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.Update[0].Hours)
            </th>
            <th style="text-align: center;">
                @Html.DisplayNameFor(model => model.Update[0].Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Update) {
        <tr>
            <td>
                <a class="nav-link" asp-page="./Edit" asp-route-id="@item.Id">
                    @Html.DisplayFor(modelItem => item.Title)
                </a>
            </td>
            <td>
                @item.Student.FirstMidName @item.Student.LastName
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Project.Title)
            </td>
            <td>
                @item.Student.FirstMidName @item.Student.LastName
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.Date)
            </td>          
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.Hours)
            </td>
            <td style="text-align: center;">
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                <a asp-page="./Details" asp-route-id="@item.Id" style="all: unset; cursor: pointer; margin-left: 10px; color: rgb(87, 87, 87);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-card-heading" viewBox="0 0 16 16">
                    <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2z"/>
                    <path d="M3 8.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5m0-5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                </a> 
                <a asp-page="./Delete" asp-route-id="@item.Id" style="all: unset; cursor: pointer; margin-left: 10px; color: rgb(87, 87, 87);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                    </svg>
                </a>
            </td>
        </tr>
}
    </tbody>
</table>
}

