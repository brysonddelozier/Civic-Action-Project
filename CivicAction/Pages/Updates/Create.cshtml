@page
@model CivicAction.Pages.Updates.CreateModel

@{
    ViewData["Title"] = "Create";
}
        
<h1>Create</h1>
        
<h4>Update</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <div asp-validation-summary="All" class="text-danger"></div>

        <form method="post">
            <div class="form-group">
                <label asp-for="Update.ProjectId" class="control-label">Select Students</label>
                <select asp-for="Update.ProjectId" class="form-control" asp-items="ViewBag.StudentId"></select>
                <span asp-validation-for="Update.ProjectId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Update.Description" class="control-label"></label>
                <textarea asp-for="Update.Description" class="form-control" aria-required="true" rows="3"/></textarea>
                <span asp-validation-for="Update.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Update.Date" class="control-label"></label>
                <input asp-for="Update.Date" class="form-control" type="date"/>
                <span asp-validation-for="Update.Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Update.Hours" class="control-label"></label>
                <input asp-for="Update.Hours" class="form-control" />
                <span asp-validation-for="Update.Hours" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
